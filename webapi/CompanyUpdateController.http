### Обновление компании с карточкой
POST https://localhost:7037/api/CompanyUpdate/update-company-with-card
Content-Type: application/json

{
  "companyId": "3fa85f64-5717-4562-b3fc-2c963f66afa6",
  "name": "ООО Обновленная Компания",
  "shortname": "ОбновКомп",
  "companyCard": {
    "directorFullName": "Иванов Иван Иванович",
    "sertificateGRUL": "GRUL123456789",
    "post": "Генеральный директор",
    "address": "г. Москва, ул. Примерная, д. 1, оф. 100",
    "email": "info@obnovkomp.ru",
    "site": "https://obnovkomp.ru",
    "locationLink": "https://maps.yandex.ru/?text=Москва, ул. Примерная, д. 1"
  }
}

### Обновление только карточки компании
POST https://localhost:7001/api/CompanyUpdate/update-company-card?companyId=12345678-1234-1234-1234-123456789012
Content-Type: application/json

{
  "directorFullName": "Петров Петр Петрович",
